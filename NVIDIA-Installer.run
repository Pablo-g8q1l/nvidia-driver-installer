#!/usr/bin/env bash

# --- Odporne tworzenie srodowiska wirtualnego --------------------------------
# Na czesci dystrybucji (np. Kubuntu 26.10) `python3 -m venv` przerywa prace,
# bo w systemie brakuje modulu ensurepip — zostawia wtedy katalog bez
# `bin/activate` i bez pipa. W takim wypadku tworzymy venv z --without-pip
# i doinstalowujemy pipa bootstrapem z bootstrap.pypa.io.
# Uzycie: make_venv <katalog_venv> [dodatkowe opcje python -m venv]
make_venv() {
    _mv_dir="$1"; shift
    _mv_py="${MAKE_VENV_PY:-python3}"
    rm -rf "$_mv_dir"
    if ! "$_mv_py" -m venv "$@" "$_mv_dir" >/dev/null 2>&1 || [ ! -f "$_mv_dir/bin/activate" ]; then
        rm -rf "$_mv_dir"
        "$_mv_py" -m venv --without-pip "$@" "$_mv_dir" || return 1
    fi
    if ! "$_mv_dir/bin/python" -m pip --version >/dev/null 2>&1; then
        _mv_gp="$_mv_dir/get-pip.py"
        if command -v curl >/dev/null 2>&1; then
            curl -fsSL https://bootstrap.pypa.io/get-pip.py -o "$_mv_gp" || return 1
        elif command -v wget >/dev/null 2>&1; then
            wget -qO "$_mv_gp" https://bootstrap.pypa.io/get-pip.py || return 1
        else
            echo "[BLAD] Do zainstalowania pipa potrzebny jest curl lub wget." >&2
            return 1
        fi
        "$_mv_dir/bin/python" "$_mv_gp" >/dev/null 2>&1 || { rm -f "$_mv_gp"; return 1; }
        rm -f "$_mv_gp"
    fi
    return 0
}
# ============================================================================
# NVIDIA Driver Installer — startup script
# Creates a Python virtual environment (.venv), installs the dependencies
# (PySide6, requests) and launches the program. Just run: ./NVIDIA-Installer.run
#
# On Debian/Ubuntu/Mint the venv and ensurepip modules ship in separate
# packages (python3-venv) — the script detects that and installs them itself.
# On the first run it shows a window explaining that the environment is being
# prepared (kdialog or zenity, whichever the system provides).
# ============================================================================
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_DIR="$SCRIPT_DIR/.venv"
REQ_FILE="$SCRIPT_DIR/requirements.txt"
STAMP_FILE="$VENV_DIR/.requirements.sha256"
APP_TITLE="NVIDIA Driver Installer"

# ---- language of user-facing messages: the system locale picks Polish or
# English (the GUI has its own language setting — this covers only the
# phase before the GUI can start)
case "${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}" in
    pl*) MSG_LANG="pl" ;;
    *)   MSG_LANG="en" ;;
esac
txt() {  # $1 = Polish, $2 = English
    if [ "$MSG_LANG" = "pl" ]; then printf '%s' "$1"; else printf '%s' "$2"; fi
}

msg() { echo -e "\033[1;32m[NVIDIA-Installer]\033[0m $*"; }
err() { echo -e "\033[1;31m[$(txt "BŁĄD" "ERROR")]\033[0m $*" >&2; }

# ------------------------------------------------------------ progress window
# The first run can take a few minutes (PySide6 download), so when a graphical
# session is available we show a window explaining what is going on.
PROGRESS_KIND="" PROGRESS_DBUS="" PROGRESS_PID="" PROGRESS_FIFO=""
QDBUS_BIN="$(command -v qdbus6 || command -v qdbus-qt6 || command -v qdbus-qt5 \
             || command -v qdbus || true)"

gui_available() { [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; }

progress_start() {
    gui_available || return 0
    if command -v kdialog >/dev/null 2>&1 && [ -n "$QDBUS_BIN" ]; then
        # kdialog returns a D-Bus reference (service + path) used to update
        # the text and close the window; maximum 0 = indeterminate bar
        PROGRESS_DBUS="$(kdialog --title "$APP_TITLE" --progressbar "$1" 0 2>/dev/null || true)"
        [ -n "$PROGRESS_DBUS" ] && PROGRESS_KIND="kdialog"
    elif command -v zenity >/dev/null 2>&1; then
        PROGRESS_FIFO="$(mktemp -u "${TMPDIR:-/tmp}/nvidia-installer-progress.XXXXXX")"
        mkfifo "$PROGRESS_FIFO"
        zenity --progress --pulsate --no-cancel --title="$APP_TITLE" \
               --text="$1" --width=420 < "$PROGRESS_FIFO" 2>/dev/null &
        PROGRESS_PID=$!
        exec 9>"$PROGRESS_FIFO"
        PROGRESS_KIND="zenity"
    fi
}

progress_text() {
    case "$PROGRESS_KIND" in
        kdialog) $QDBUS_BIN $PROGRESS_DBUS setLabelText "$1" >/dev/null 2>&1 || true ;;
        zenity)  echo "# $1" >&9 2>/dev/null || true ;;
    esac
}

progress_end() {
    case "$PROGRESS_KIND" in
        kdialog) $QDBUS_BIN $PROGRESS_DBUS close >/dev/null 2>&1 || true ;;
        zenity)  exec 9>&- 2>/dev/null || true
                 kill "$PROGRESS_PID" 2>/dev/null || true
                 rm -f "$PROGRESS_FIFO" ;;
    esac
    PROGRESS_KIND=""
}

# Error window for launches without a terminal (e.g. from a file manager)
show_error() {
    err "$*"
    gui_available || return 0
    if command -v kdialog >/dev/null 2>&1; then
        kdialog --title "$APP_TITLE" --error "$*" 2>/dev/null || true
    elif command -v zenity >/dev/null 2>&1; then
        zenity --error --title="$APP_TITLE" --text="$*" --width=420 2>/dev/null || true
    fi
}

cleanup() { progress_end; }
trap cleanup EXIT

# ---------------------------------------------------------------- python3
if ! command -v python3 >/dev/null 2>&1; then
    show_error "$(txt "Nie znaleziono python3. Zainstaluj go poleceniem:" \
                     "python3 not found. Install it with:")
  Arch / CachyOS / EndeavourOS:  sudo pacman -S python
  Fedora / Nobara:               sudo dnf install python3
  Debian / Kubuntu / Mint:       sudo apt install python3 python3-venv"
    exit 1
fi

# ------------------------------------------------- running a command as root
# In a terminal it asks for the password via sudo; without a terminal it tries
# pkexec, and on KDE without pkexec — a kdialog password box piped to sudo -S.
run_as_root() {
    if [ -t 0 ] && command -v sudo >/dev/null 2>&1; then
        sudo "$@"
    elif command -v pkexec >/dev/null 2>&1; then
        pkexec "$@"
    elif gui_available && command -v kdialog >/dev/null 2>&1 \
         && command -v sudo >/dev/null 2>&1; then
        kdialog --title "$APP_TITLE" \
                --password "$(txt "Podaj hasło administratora, aby doinstalować pakiety Pythona:" \
                                  "Enter the administrator password to install Python packages:")" \
            | sudo -S "$@"
    else
        return 1
    fi
}

# ------------------------------------------------- venv + ensurepip modules
# On Debian/Ubuntu/Mint ensurepip ships in the python3-venv package. Without
# it the venv is created WITHOUT pip and dependency installation fails with
# "No module named pip" — so we check and install upfront.
if ! python3 -c "import venv, ensurepip" >/dev/null 2>&1; then
    if command -v apt-get >/dev/null 2>&1; then
        msg "$(txt "Brak modułu venv/ensurepip — doinstalowuję pakiet python3-venv (wymaga hasła administratora)..." \
                   "venv/ensurepip module missing — installing the python3-venv package (administrator password required)...")"
        if ! run_as_root apt-get install -y python3-venv python3-pip; then
            show_error "$(txt "Nie udało się zainstalować pakietów. Uruchom ręcznie:
  sudo apt install python3-venv python3-pip
i włącz program ponownie." \
                              "Package installation failed. Run manually:
  sudo apt install python3-venv python3-pip
and start the program again.")"
            exit 1
        fi
    else
        show_error "$(txt "Brak modułu venv/ensurepip dla Pythona. Zainstaluj go poleceniem:" \
                         "The Python venv/ensurepip module is missing. Install it with:")
  Fedora / Nobara:               sudo dnf install python3
  Arch / CachyOS / EndeavourOS:  $(txt "(venv jest częścią pakietu python)" \
                                       "(venv is part of the python package)")"
        exit 1
    fi
    # Post-install check — the next steps require a working ensurepip
    if ! python3 -c "import venv, ensurepip" >/dev/null 2>&1; then
        show_error "$(txt "Moduł venv/ensurepip nadal niedostępny mimo instalacji pakietów." \
                         "The venv/ensurepip module is still unavailable despite installing the packages.")"
        exit 1
    fi
fi

# --------------------------------------------- broken environment recovery
# An interrupted first run can leave a .venv without pip — we detect that
# and rebuild the environment from scratch.
if [ -x "$VENV_DIR/bin/python" ] \
   && ! "$VENV_DIR/bin/python" -m pip --version >/dev/null 2>&1; then
    msg "$(txt "Wykryto uszkodzone środowisko wirtualne (brak pip) — tworzę od nowa..." \
               "Detected a broken virtual environment (pip missing) — recreating it...")"
    rm -rf "$VENV_DIR"
fi

# ---------------------------------------------------------------- venv creation
FIRST_RUN=0
if [ ! -x "$VENV_DIR/bin/python" ]; then
    FIRST_RUN=1
    msg "$(txt "Pierwsze uruchomienie — tworzenie środowiska wirtualnego w $VENV_DIR ..." \
               "First run — creating the virtual environment in $VENV_DIR ...")"
    progress_start "$(txt "Pierwsze uruchomienie: przygotowywanie środowiska wirtualnego Pythona..." \
                         "First run: preparing the Python virtual environment...")"
    # A failed creation must not leave a partial .venv behind
    if ! make_venv "$VENV_DIR"; then
        rm -rf "$VENV_DIR"
        show_error "$(txt "Nie udało się utworzyć środowiska wirtualnego Pythona." \
                         "Failed to create the Python virtual environment.")"
        exit 1
    fi
fi

# ---------------------------------------- dependencies (only when they changed)
NEW_SUM="$(sha256sum "$REQ_FILE" | cut -d' ' -f1)"
OLD_SUM="$(cat "$STAMP_FILE" 2>/dev/null || true)"
if [ "$NEW_SUM" != "$OLD_SUM" ]; then
    msg "$(txt "Instalowanie zależności (PySide6, requests) — może potrwać chwilę..." \
               "Installing dependencies (PySide6, requests) — this may take a while...")"
    [ "$FIRST_RUN" = 1 ] || progress_start "$(txt "Aktualizowanie zależności programu..." \
                                               "Updating the program dependencies...")"
    progress_text "$(txt "Instalowanie zależności (PySide6, requests) — to może potrwać kilka minut..." \
                        "Installing dependencies (PySide6, requests) — this may take a few minutes...")"
    if ! { "$VENV_DIR/bin/python" -m pip install --upgrade pip --quiet \
           && "$VENV_DIR/bin/python" -m pip install -r "$REQ_FILE"; }; then
        show_error "$(txt "Instalacja zależności (PySide6, requests) nie powiodła się.
Sprawdź połączenie z internetem i uruchom program ponownie." \
                          "Installing the dependencies (PySide6, requests) failed.
Check your internet connection and start the program again.")"
        exit 1
    fi
    echo "$NEW_SUM" > "$STAMP_FILE"
else
    msg "$(txt "Zależności aktualne." "Dependencies up to date.")"
fi
progress_end

# --------------------------------- system libraries required by PySide6
# pip's PySide6 bundles its own Qt but still links against system libraries
# (e.g. libgthread-2.0.so.0 from glib2). A minimal install may lack them
# (openSUSE Tumbleweed 2026-07-15) — the import fails before any window opens.
# We condition on the ACTUAL import, not the distro name: when it passes we
# do nothing (no-op on a healthy system); when it fails on a missing library
# we install the package providing exactly that library — in the rpm world
# zypper/dnf resolve packages by the "soname()(64bit)" capability themselves.
# A loop, because several libraries may be missing; an unknown import error
# shows the full message.
lib_install_hint() {
    show_error "$(txt "Brakuje biblioteki systemowej: $1
Nie udało się jej doinstalować automatycznie. Zainstaluj pakiet, który ją
dostarcza, i uruchom program ponownie (np. openSUSE:
  sudo zypper install --capability '$1()(64bit)')" \
                      "Missing system library: $1
It could not be installed automatically. Install the package that provides
it and start the program again (e.g. openSUSE:
  sudo zypper install --capability '$1()(64bit)')")"
    exit 1
}

check_pyside_libs() {
    local out lib i
    for i in 1 2 3 4 5; do
        out="$("$VENV_DIR/bin/python" -c 'from PySide6 import QtWidgets' 2>&1)" \
            && return 0
        lib="$(printf '%s\n' "$out" | sed -n \
            's/^ImportError: \([^:]*\.so[^:]*\): cannot open shared object file.*/\1/p' \
            | head -1)"
        if [ -z "$lib" ]; then
            show_error "$(txt "Nie udało się uruchomić PySide6:" \
                             "Failed to start PySide6:")
$out"
            exit 1
        fi
        msg "$(txt "Brak biblioteki systemowej $lib — doinstalowuję (wymaga hasła administratora)..." \
                   "System library $lib is missing — installing it (administrator password required)...")"
        if command -v zypper >/dev/null 2>&1; then
            run_as_root zypper -n install --capability "${lib}()(64bit)" \
                || lib_install_hint "$lib"
        elif command -v dnf >/dev/null 2>&1; then
            run_as_root dnf install -y "${lib}()(64bit)" \
                || lib_install_hint "$lib"
        else
            lib_install_hint "$lib"
        fi
    done
    lib_install_hint "$lib"
}
check_pyside_libs

# ------------------------------------------------- application menu shortcut
# COSMIC and GNOME do not execute files from the file manager — a double
# click opens the script in a text editor (Pop!_OS COSMIC, 2026-07-23);
# on KDE Dolphin asks "run?", so the problem never showed there. After the
# environment is ready we add a menu entry with an absolute path — from now
# on the program launches from the application menu on every desktop.
# Idempotent: an existing entry with identical content = no-op; after moving
# the directory the entry updates on the next launch from a terminal.
install_menu_entry() {
    local dir="$HOME/.local/share/applications"
    local file="$dir/nvidia-driver-installer.desktop"
    # The Exec value undergoes field-code expansion (%f, %u...) — a literal
    # "%" in the path must be doubled per the Desktop Entry spec
    local exec_dir="${SCRIPT_DIR//%/%%}"
    local content="[Desktop Entry]
Type=Application
Name=$APP_TITLE
Comment=Instalator sterowników NVIDIA / NVIDIA driver installer
Exec=\"$exec_dir/NVIDIA-Installer.run\"
Terminal=false
Categories=System;Settings;HardwareSettings;"
    if [ -f "$SCRIPT_DIR/icons8-nvidia-48.png" ]; then
        content="$content
Icon=$SCRIPT_DIR/icons8-nvidia-48.png"
    fi
    if [ "$(cat "$file" 2>/dev/null)" = "$content" ]; then
        return 0
    fi
    mkdir -p "$dir"
    printf '%s\n' "$content" > "$file"
    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database "$dir" 2>/dev/null || true
    fi
    msg "$(txt "Dodano skrót w menu aplikacji: $file" \
               "Added an application menu shortcut: $file")"
}
install_menu_entry

# ---------------------------------------------------------------- program start
msg "$(txt "Uruchamianie NVIDIA Driver Installer..." \
           "Starting NVIDIA Driver Installer...")"
exec "$VENV_DIR/bin/python" "$SCRIPT_DIR/main.py" "$@"
